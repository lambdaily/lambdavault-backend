#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -h "$SCRIPT_PATH" ]]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
  SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
  if [[ "$SCRIPT_PATH" != /* ]]; then
    SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
  fi
done
ROOT_DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
APP_PORT="${APP_PORT:-8081}"
PROD_API_URL="${PROD_API_URL:-https://lambdavault-backend-production.up.railway.app}"

usage() {
  cat <<'EOF'
Usage:
  lambdavault run <device_or_alias> [port]
  lambdavault run <device_or_alias> prod [api_url]
  lambdavault set-password <email> [new_password]

Device aliases:
  macos     (desktop)
  ios       (first available iOS simulator/device)
  android   (first available Android emulator/device)

You can also pass a concrete Flutter device id (for example: emulator-5554).

Examples:
  lambdavault run macos
  lambdavault run android
  lambdavault run ios prod
  lambdavault run emulator-5554 prod
  lambdavault run macos 8081
  lambdavault run macos prod https://lambdavault-backend-production.up.railway.app
  APP_PORT=8082 lambdavault run android
  lambdavault set-password pablo.espinoza.mail@gmail.com
EOF
}

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Missing required command: $1" >&2
    exit 1
  fi
}

validate_port() {
  local port="$1"

  if [[ ! "$port" =~ ^[0-9]+$ ]]; then
    echo "Invalid port: $port" >&2
    exit 1
  fi

  if ((port < 1 || port > 65535)); then
    echo "Port out of range (1-65535): $port" >&2
    exit 1
  fi
}

validate_url() {
  local url="$1"

  if [[ ! "$url" =~ ^https?:// ]]; then
    echo "Invalid URL: $url" >&2
    echo "Expected format: https://example.com" >&2
    exit 1
  fi
}

wait_for_backend() {
  local retries=30
  local delay=1

  for ((i = 1; i <= retries; i++)); do
    if nc -z localhost "$APP_PORT" >/dev/null 2>&1; then
      return 0
    fi
    sleep "$delay"
  done

  return 1
}

resolve_device_id() {
  local requested="$1"

  case "$requested" in
    macos)
      echo "macos"
      return 0
      ;;
    android)
      local android_id
      android_id="$(flutter devices | awk -F '•' '/android/ {gsub(/^[ \t]+|[ \t]+$/, "", $2); print $2; exit}')"
      if [[ -z "$android_id" ]]; then
        echo "No Android device/emulator found. Start one and try again." >&2
        echo "Tip: run 'flutter devices' to list available IDs." >&2
        exit 1
      fi
      echo "$android_id"
      return 0
      ;;
    ios)
      local ios_id
      ios_id="$(flutter devices | awk -F '•' '/ios|darwin-ios/ {gsub(/^[ \t]+|[ \t]+$/, "", $2); print $2; exit}')"
      if [[ -z "$ios_id" ]]; then
        echo "No iOS simulator/device found. Start one and try again." >&2
        echo "Tip: run 'flutter devices' to list available IDs." >&2
        exit 1
      fi
      echo "$ios_id"
      return 0
      ;;
    *)
      # Assume it's a concrete Flutter device id.
      echo "$requested"
      return 0
      ;;
  esac
}

run_all() {
  local requested_device="$1"
  local device
  device="$(resolve_device_id "$requested_device")"
  local backend_pid=""

  cleanup() {
    if [[ -n "$backend_pid" ]] && kill -0 "$backend_pid" >/dev/null 2>&1; then
      echo "\nStopping backend (PID: $backend_pid)..."
      kill "$backend_pid" >/dev/null 2>&1 || true
      wait "$backend_pid" 2>/dev/null || true
    fi
  }

  trap cleanup EXIT INT TERM

  echo "Starting backend on port $APP_PORT..."
  (
    cd "$ROOT_DIR"
    APP_PORT="$APP_PORT" make dev
  ) &
  backend_pid=$!

  if ! wait_for_backend; then
    echo "Backend did not become ready on port $APP_PORT." >&2
    exit 1
  fi

  echo "Backend ready. Starting Flutter on $device (requested: $requested_device)..."
  (
    cd "$ROOT_DIR/mobile"
    flutter run -d "$device"
  )
}

run_prod() {
  local requested_device="$1"
  local device
  device="$(resolve_device_id "$requested_device")"
  local api_url="$2"

  validate_url "$api_url"

  echo "Starting Flutter on $device (requested: $requested_device) using production API: $api_url"
  (
    cd "$ROOT_DIR/mobile"
    flutter run -d "$device" --dart-define="API_BASE_URL=$api_url"
  )
}

set_password() {
  local email="$1"
  local new_password="${2:-}"
  local confirm_password=""

  if [[ -z "$email" ]]; then
    echo "Email is required." >&2
    usage
    exit 1
  fi

  if [[ -z "$new_password" ]]; then
    read -r -s -p "New password: " new_password
    echo
    read -r -s -p "Confirm password: " confirm_password
    echo

    if [[ "$new_password" != "$confirm_password" ]]; then
      echo "Passwords do not match." >&2
      exit 1
    fi
  fi

  if [[ -z "$new_password" ]]; then
    echo "Password cannot be empty." >&2
    exit 1
  fi

  (
    cd "$ROOT_DIR"
    LV_NEW_PASSWORD="$new_password" go run ./cmd/tools/set_password --email "$email" --password-env LV_NEW_PASSWORD
  )
}

main() {
  local command="${1:-}"
  case "$command" in
    run)
      require_cmd flutter

      local device="${2:-}"
      if [[ -z "$device" ]]; then
        usage
        exit 1
      fi

      local run_mode_or_port="${3:-}"

      if [[ "$run_mode_or_port" == "prod" ]]; then
        local api_url="${4:-$PROD_API_URL}"
        run_prod "$device" "$api_url"
      else
        require_cmd make
        require_cmd nc

        if [[ -n "$run_mode_or_port" ]]; then
          validate_port "$run_mode_or_port"
          APP_PORT="$run_mode_or_port"
        fi

        run_all "$device"
      fi
      ;;
    set-password)
      require_cmd go
      set_password "${2:-}" "${3:-}"
      ;;
    *)
      usage
      exit 1
      ;;
  esac
}

main "$@"
