# =====================================================================
# Server
# =====================================================================
APP_ENV=development            # development | production
APP_PORT=8080
APP_NAME=lambdavault

# =====================================================================
# Database
# =====================================================================
# Choose one: sqlite (dev only) | postgres (production)
DB_DRIVER=sqlite

# SQLite (only used when DB_DRIVER=sqlite)
DB_PATH=./data/lambdavault.db

# Postgres (only used when DB_DRIVER=postgres). Railway / managed providers
# typically inject this as DATABASE_URL automatically — DB_DSN takes
# precedence if both are set.
# DB_DSN=postgres://user:pass@host:5432/lambdavault?sslmode=require

# Production refuses to boot with sqlite. Set this to "true" only if you
# really know what you are doing (e.g. mounted persistent volume).
# ALLOW_SQLITE_IN_PRODUCTION=false

# =====================================================================
# Security
# =====================================================================
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_HOURS=24

# Generate with: openssl rand -hex 16   (must be EXACTLY 32 chars)
ENCRYPTION_KEY=

# =====================================================================
# Rate Limiting (per IP)
# =====================================================================
# Global limit applied to every request.
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
# Stricter limit applied to /api/v1/auth/* (login & register).
RATE_LIMIT_AUTH_RPS=1
RATE_LIMIT_AUTH_BURST=5

# =====================================================================
# CORS
# =====================================================================
# Comma-separated list of allowed origins. REQUIRED in production.
# Example: CORS_ORIGINS=https://app.lambdavault.com,https://admin.lambdavault.com
CORS_ORIGINS=
